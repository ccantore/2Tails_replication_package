@Techreport{Auclert:2020,
	abstract = {We explore the transmission mechanism of income inequality to output. In the short run, higher inequality reduces output because marginal propensities to consume are negatively correlated with incomes, but this effect is quantitatively small in both the data and our model. In the long run, the output effects of income inequality are small if inequality is caused by rising dispersion in individual fixed effects, but can be large if it is the manifestation of higher individual income risk. We arrive at these conclusions using a new and general methodology to translate the partial equilibrium effects of income inequality on consumption into general equilibrium effects on output.},
	author = {Auclert, Adrien and Rognlie, Matthew},
	file = {Auclert and Rognlie - Inequality and Aggregate Demand.pdf:/Users/cristiano/Zotero/storage/BWX5SWFH/Auclert and Rognlie - Inequality and Aggregate Demand.pdf:application/pdf},
