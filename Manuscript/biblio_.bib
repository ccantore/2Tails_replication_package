@article{bayer_shocks_2020,
	title = {Shocks, {Frictions}, and {Inequality} in {US} {Business} {Cycles}},
	abstract = {How much does inequality matter for the business cycle and vice versa? Using a Bayesian likelihood approach, we estimate a heterogeneous-agent New-Keynesian (HANK) model with incomplete markets and portfolio choice between liquid and illiquid assets. Even when the model is estimated on aggregate data only and with only a set of shocks and frictions along the lines of Smets and Wouters (2007), it reproduces observed US inequality dynamics. In other words, the model is successful in simultaneously accounting for cycle and distribution. Output stabilization via monetary or ﬁscal policy also stabilizes inequality.},
	language = {en},
	journal = {SSRN Electronic Journal},
	author = {Bayer, Christian and Born, Benjamin and Luetticke, Ralph},
	year = {2022}
}


@techreport{patterson:2021,
	title = {The Matching Multiplier and the Amplification of Recessions}, 
	abstract = {This paper shows that the unequal incidence of recessions in the labor market ampliﬁes aggregate shocks. Using administrative data from the United States, I document a positive covariance between worker marginal propensities to consume (MPCs) and their elasticities of earnings to GDP, which is a key moment for a new class of heterogeneous-agent models. I deﬁne the Matching Multiplier as the increase in the multiplier stemming from this matching of high MPC workers to more cyclical jobs. I show that this covariance is large enough to increase the aggregate MPC by almost 30 percent over an equal exposure benchmark.},
	language = {en},
	author = {Patterson, Christina},
	year = {2021},
	 type = "Mimeo",
	file = {Patterson - The Matching Multiplier and the Ampliﬁcation of Re.pdf:/Users/cristiano/Zotero/storage/ZQR3CIJJ/Patterson - The Matching Multiplier and the Ampliﬁcation of Re.pdf:application/pdf},
}


