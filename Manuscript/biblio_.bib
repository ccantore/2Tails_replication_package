@article{GerkoRey:2017,
	abstract = {{The importance of financial markets and international capital flows has increased greatly since the 1990s. How does this affect the effectiveness of monetary policy? We analyse the transmission of monetary policy in two important financial centres, the United States and the United Kingdom. Studying the responses of mortgage and corporate spreads, we find evidence in favour of an important financial channel in both countries. Our identification strategy allows us to study the effect of movements in the policy instruments and forward guidance, broadly defined. We also analyse international financial spillovers, which we find to be asymmetric. (JEL: E32, E43, E44, G01)}},
