@article{SGU:2003,
	abstract = {The small open economy model with incomplete asset markets features a steady state that depends on initial conditions. In addition, equilibrium dynamics posses a random walk component. A number of modifications to the standard model have been proposed to induce stationarity. This Paper presents a quantitative comparison of these alternative approaches. Five different specifications are considered: (1) A model with an endogenous discount factor (Uzawa-type preferences); (2) A model with a debt-elastic interest-rate premium; (3) A model with convex portfolio adjustment costs; (4) A model with complete asset markets; (5) A model without stationarity-inducing features. The main finding of the Paper is that all models deliver virtually identical dynamics at business-cycle frequencies, as measured by unconditional second moments and impulse response functions. The only noticeable difference among the alternative specifications is that the complete-asset-market model induces smoother consumption dynamics.{$<$}br{$><$}small{$>$}(This abstract was borrowed from another version of this item.){$<$}/small{$>$}},
	author = {{Schmitt-Grohe}, Stephanie and Uribe, Martin},
	file = {C\:\\Users\\lbf25\\Dropbox\\Study\\Zotero\\storage\\6ZKVN6ZQ\\v61y2003i1p163-185.html},
	journal = {Journal of International Economics},
	language = {en},
	number = {1},
	pages = {163--185},
	title = {Closing {{Small Open Economy Models}}},
	volume = {61},
	year = {2003}}

@article{NP:2005,
	abstract = {We find that in a sample of emerging economies business cycles are more volatile than in developed ones, real interest rates are countercyclical and lead the cycle, consumption is more volatile than output and net exports are strongly countercyclical. We present a model of a small open economy, where the real interest rate is decomposed in an international rate and a country risk component. Country risk is affected by fundamental shocks but, through the presence of working capital, also amplifies the effects of those shocks. The model generates business cycles consistent with Argentine data. Eliminating country risk lowers Argentine output volatility by 27\% while stabilizing international rates lowers it by less than 3\%.},
	author = {Neumeyer, Pablo A. and Perri, Fabrizio},
	doi = {10.1016/j.jmoneco.2004.04.011},
	file = {C\:\\Users\\lbf25\\Dropbox\\Study\\Zotero\\storage\\LGHXHFB9\\Neumeyer and Perri - 2005 - Business cycles in emerging economies the role of.pdf;C\:\\Users\\lbf25\\Dropbox\\Study\\Zotero\\storage\\6T7T7DMH\\S0304393205000036.html},
	issn = {0304-3932},
	journal = {Journal of Monetary Economics},
	keywords = {Country risk,Financial crises,International business cycles,Sudden stops,Working capital},
	language = {en},
	month = mar,
	number = {2},
	pages = {345--380},
	shorttitle = {Business Cycles in Emerging Economies},
	title = {Business {{Cycles}} in {{Emerging Economies}}: The {{Role}} of {{Interest Rates}}},
	volume = {52},
	year = {2005},
	}

@article{Rotemberg:1982,
	abstract = {It has often been argued that prices are sticky in the United States. However, the empirical papers that have claimed to support this view have not reflected any formal behavioral theory. This paper presents a theory that justifies price stickiness, namely, that firms, fearing to upset their customers, attribute a cost to price changes. The rational expectations equilibrium of an economy with many such firms is presented, estimated with postwar U.S. data, and tested against alternative hypotheses. The results largely support the model. Furthermore, the hypothesis that prices are not sticky is rejected by U.S. data.},
	author = {Julio J. Rotemberg},
	issn = {00223808, 1537534X},
	journal = {Journal of Political Economy},
	number = {6},
	pages = {1187--1211},
	publisher = {University of Chicago Press},
	title = {Sticky Prices in the United States},
	volume = {90},
	year = {1982}
	}

